{
  "$defs": {
    "AgentMemoryContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "agent-memory-context/1.0",
          "default": "agent-memory-context/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_policy_version": {
          "const": "memory-context-policy/1.0",
          "default": "memory-context-policy/1.0",
          "title": "Selection Policy Version",
          "type": "string"
        },
        "role": {
          "enum": [
            "execution",
            "recovery",
            "plan"
          ],
          "title": "Role",
          "type": "string"
        },
        "goal_id": {
          "minLength": 1,
          "title": "Goal Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "target_week_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Week Start"
        },
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Hash",
          "type": "string"
        },
        "audit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audit Hash",
          "type": "string"
        },
        "selected_preferences": {
          "items": {
            "$ref": "#/$defs/PreferenceMemoryContextItem"
          },
          "maxItems": 5,
          "title": "Selected Preferences",
          "type": "array"
        },
        "selected_weekly_memories": {
          "items": {
            "discriminator": {
              "mapping": {
                "plan": "#/$defs/PlanWeeklyMemoryContextItem",
                "recovery": "#/$defs/RecoveryWeeklyMemoryContextItem"
              },
              "propertyName": "role"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RecoveryWeeklyMemoryContextItem"
              },
              {
                "$ref": "#/$defs/PlanWeeklyMemoryContextItem"
              }
            ]
          },
          "maxItems": 8,
          "title": "Selected Weekly Memories",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/MemoryContextDecision"
          },
          "maxItems": 100,
          "title": "Decisions",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/MemoryContextBudget"
        }
      },
      "required": [
        "role",
        "goal_id",
        "as_of",
        "context_hash",
        "audit_hash",
        "budget"
      ],
      "title": "按职责裁剪的 Agent 记忆上下文",
      "type": "object"
    },
    "MemoryContextBudget": {
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "max_chars": {
          "minimum": 0,
          "title": "Max Chars",
          "type": "integer"
        },
        "used_items": {
          "minimum": 0,
          "title": "Used Items",
          "type": "integer"
        },
        "used_chars": {
          "minimum": 0,
          "title": "Used Chars",
          "type": "integer"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "excluded_by_budget": {
          "minimum": 0,
          "title": "Excluded By Budget",
          "type": "integer"
        }
      },
      "required": [
        "max_items",
        "max_chars",
        "used_items",
        "used_chars",
        "candidate_count",
        "excluded_by_budget"
      ],
      "title": "MemoryContextBudget",
      "type": "object"
    },
    "MemoryContextDecision": {
      "additionalProperties": false,
      "properties": {
        "memory_type": {
          "enum": [
            "athlete_preference",
            "weekly_training_memory"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "status": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "selected_role_relevant",
            "excluded_role_not_allowed",
            "excluded_wrong_goal",
            "excluded_future",
            "excluded_expired",
            "excluded_superseded",
            "excluded_archived",
            "excluded_invalidated",
            "excluded_outside_target_window",
            "excluded_item_budget",
            "excluded_character_budget"
          ],
          "title": "Reason",
          "type": "string"
        },
        "selected_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Order"
        },
        "estimated_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Chars",
          "type": "integer"
        }
      },
      "required": [
        "memory_type",
        "memory_id",
        "status",
        "selected",
        "reason"
      ],
      "title": "MemoryContextDecision",
      "type": "object"
    },
    "PlanChangeProposalDraft": {
      "additionalProperties": false,
      "description": "可交给 TrainingCycleService 的提案参数，不代表已保存或已批准。",
      "properties": {
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "base_revision": {
          "minimum": 1,
          "title": "Base Revision",
          "type": "integer"
        },
        "proposed_by": {
          "const": "plan_agent",
          "default": "plan_agent",
          "title": "Proposed By",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/PlanSessionPatch"
          },
          "maxItems": 14,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidence Refs",
          "type": "array"
        },
        "requires_user_confirmation": {
          "const": true,
          "default": true,
          "title": "Requires User Confirmation",
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "base_revision",
        "reason",
        "changes"
      ],
      "title": "PlanChangeProposalDraft",
      "type": "object"
    },
    "PlanSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scheduled_for": {
          "format": "date",
          "title": "Scheduled For",
          "type": "string"
        },
        "session_type": {
          "enum": [
            "easy",
            "long_run",
            "tempo",
            "interval",
            "recovery",
            "rest",
            "test"
          ],
          "title": "Session Type",
          "type": "string"
        },
        "distance_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Meters"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "intensity": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "purpose": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "completed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "linked_activity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linked Activity Id"
        }
      },
      "required": [
        "scheduled_for",
        "session_type",
        "purpose"
      ],
      "title": "PlanSession",
      "type": "object"
    },
    "PlanSessionPatch": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        },
        "session_type": {
          "anyOf": [
            {
              "enum": [
                "easy",
                "long_run",
                "tempo",
                "interval",
                "recovery",
                "rest",
                "test"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Type"
        },
        "distance_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Meters"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "clear_distance": {
          "default": false,
          "title": "Clear Distance",
          "type": "boolean"
        },
        "clear_duration": {
          "default": false,
          "title": "Clear Duration",
          "type": "boolean"
        },
        "clear_intensity": {
          "default": false,
          "title": "Clear Intensity",
          "type": "boolean"
        },
        "intensity": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "PlanSessionPatch",
      "type": "object"
    },
    "PlanWeeklyMemoryContextItem": {
      "additionalProperties": false,
      "description": "Plan 可读取的周训练基线；类型层面不存在恢复敏感字段。",
      "properties": {
        "memory_type": {
          "const": "weekly_training_memory",
          "default": "weekly_training_memory",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "week_start": {
          "format": "date",
          "title": "Week Start",
          "type": "string"
        },
        "week_end": {
          "format": "date",
          "title": "Week End",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "completion_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Rate"
        },
        "actual_duration_seconds": {
          "minimum": 0,
          "title": "Actual Duration Seconds",
          "type": "integer"
        },
        "actual_distance_meters": {
          "minimum": 0,
          "title": "Actual Distance Meters",
          "type": "number"
        },
        "check_in_days": {
          "minimum": 0,
          "title": "Check In Days",
          "type": "integer"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Data",
          "type": "array"
        },
        "role": {
          "const": "plan",
          "default": "plan",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "week_start",
        "week_end",
        "version",
        "input_hash",
        "actual_duration_seconds",
        "actual_distance_meters",
        "check_in_days"
      ],
      "title": "PlanWeeklyMemoryContextItem",
      "type": "object"
    },
    "PlanningEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "goal",
            "availability",
            "athlete_preference",
            "weekly_training_memory",
            "memory_context",
            "training_history",
            "current_plan",
            "recovery_action",
            "engineering_rule",
            "missing_data"
          ],
          "title": "Type",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "rule_source": {
          "enum": [
            "user_goal",
            "confirmed_athlete_preference",
            "confirmed_training_memory",
            "role_scoped_memory_context",
            "normalized_activity",
            "active_plan",
            "recovery_assessment",
            "runcrew_conservative_rule",
            "missing_data_policy"
          ],
          "title": "Rule Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "message",
        "rule_source"
      ],
      "title": "PlanningEvidence",
      "type": "object"
    },
    "PreferenceMemoryContextItem": {
      "additionalProperties": false,
      "properties": {
        "memory_type": {
          "const": "athlete_preference",
          "default": "athlete_preference",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "key": {
          "const": "preferred_long_run_weekday",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Value",
          "type": "string"
        },
        "schema_version": {
          "const": "athlete-preference/1.0",
          "default": "athlete-preference/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "key",
        "value"
      ],
      "title": "PreferenceMemoryContextItem",
      "type": "object"
    },
    "RecoveryAssessmentSnapshot": {
      "additionalProperties": false,
      "properties": {
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "recommendation": {
          "enum": [
            "proceed",
            "reduce",
            "rest",
            "seek_professional_help",
            "insufficient_data"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "plan_action": {
          "$ref": "#/$defs/RecoveryPlanAction"
        }
      },
      "required": [
        "input_hash",
        "recommendation",
        "plan_action"
      ],
      "title": "RecoveryAssessmentSnapshot",
      "type": "object"
    },
    "RecoveryPlanAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "keep",
            "ask_plan_agent_to_reduce",
            "ask_plan_agent_to_replace_with_rest",
            "hold_until_professional_review",
            "wait_for_more_data"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Session Id"
        },
        "requires_user_confirmation": {
          "default": true,
          "title": "Requires User Confirmation",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "RecoveryPlanAction",
      "type": "object"
    },
    "RecoveryWeeklyMemoryContextItem": {
      "additionalProperties": false,
      "description": "Recovery 可读取的周负荷与恢复聚合。",
      "properties": {
        "memory_type": {
          "const": "weekly_training_memory",
          "default": "weekly_training_memory",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "week_start": {
          "format": "date",
          "title": "Week Start",
          "type": "string"
        },
        "week_end": {
          "format": "date",
          "title": "Week End",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "completion_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Rate"
        },
        "actual_duration_seconds": {
          "minimum": 0,
          "title": "Actual Duration Seconds",
          "type": "integer"
        },
        "actual_distance_meters": {
          "minimum": 0,
          "title": "Actual Distance Meters",
          "type": "number"
        },
        "check_in_days": {
          "minimum": 0,
          "title": "Check In Days",
          "type": "integer"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Data",
          "type": "array"
        },
        "role": {
          "const": "recovery",
          "default": "recovery",
          "title": "Role",
          "type": "string"
        },
        "average_fatigue": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Fatigue"
        },
        "average_soreness": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Soreness"
        },
        "average_readiness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Readiness"
        },
        "max_pain_severity": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pain Severity"
        },
        "acute_symptom_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acute Symptom Days"
        }
      },
      "required": [
        "memory_id",
        "week_start",
        "week_end",
        "version",
        "input_hash",
        "actual_duration_seconds",
        "actual_distance_meters",
        "check_in_days"
      ],
      "title": "RecoveryWeeklyMemoryContextItem",
      "type": "object"
    },
    "TrainingPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "goal_id": {
          "minLength": 1,
          "title": "Goal Id",
          "type": "string"
        },
        "week_start": {
          "format": "date",
          "title": "Week Start",
          "type": "string"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "active",
            "superseded",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source": {
          "default": "user",
          "enum": [
            "user",
            "deterministic",
            "plan_agent"
          ],
          "title": "Source",
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/PlanSession"
          },
          "maxItems": 14,
          "title": "Sessions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "week_start"
      ],
      "title": "TrainingPlan",
      "type": "object"
    },
    "TrainingPlanningResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ruleset_version": {
          "const": "training-plan-rules/1.0",
          "default": "training-plan-rules/1.0",
          "title": "Ruleset Version",
          "type": "string"
        },
        "operation": {
          "enum": [
            "draft_week",
