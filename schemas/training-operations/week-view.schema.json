{
  "$defs": {
    "AgentMemoryContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "agent-memory-context/1.0",
          "default": "agent-memory-context/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_policy_version": {
          "const": "memory-context-policy/1.0",
          "default": "memory-context-policy/1.0",
          "title": "Selection Policy Version",
          "type": "string"
        },
        "role": {
          "enum": [
            "execution",
            "recovery",
            "plan"
          ],
          "title": "Role",
          "type": "string"
        },
        "goal_id": {
          "minLength": 1,
          "title": "Goal Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "target_week_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Week Start"
        },
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Hash",
          "type": "string"
        },
        "audit_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audit Hash",
          "type": "string"
        },
        "selected_preferences": {
          "items": {
            "$ref": "#/$defs/PreferenceMemoryContextItem"
          },
          "maxItems": 5,
          "title": "Selected Preferences",
          "type": "array"
        },
        "selected_weekly_memories": {
          "items": {
            "discriminator": {
              "mapping": {
                "plan": "#/$defs/PlanWeeklyMemoryContextItem",
                "recovery": "#/$defs/RecoveryWeeklyMemoryContextItem"
              },
              "propertyName": "role"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RecoveryWeeklyMemoryContextItem"
              },
              {
                "$ref": "#/$defs/PlanWeeklyMemoryContextItem"
              }
            ]
          },
          "maxItems": 8,
          "title": "Selected Weekly Memories",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/MemoryContextDecision"
          },
          "maxItems": 100,
          "title": "Decisions",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/MemoryContextBudget"
        }
      },
      "required": [
        "role",
        "goal_id",
        "as_of",
        "context_hash",
        "audit_hash",
        "budget"
      ],
      "title": "按职责裁剪的 Agent 记忆上下文",
      "type": "object"
    },
    "ExecutionCandidate": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "minLength": 1,
          "title": "Activity Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "date_difference_days": {
          "minimum": 0,
          "title": "Date Difference Days",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "distance_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Ratio"
        },
        "duration_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ratio"
        }
      },
      "required": [
        "activity_id",
        "started_at",
        "date_difference_days",
        "score"
      ],
      "title": "ExecutionCandidate",
      "type": "object"
    },
    "ExecutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "schedule",
            "date_proximity",
            "volume_comparison",
            "confirmed_link",
            "candidate_conflict",
            "missing_data"
          ],
          "title": "Type",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "rule_source": {
          "enum": [
            "active_plan",
            "normalized_activity",
            "user_confirmation",
            "runcrew_matching_rule",
            "missing_data_policy"
          ],
          "title": "Rule Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "message",
        "rule_source"
      ],
      "title": "ExecutionEvidence",
      "type": "object"
    },
    "MemoryContextBudget": {
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "minimum": 0,
          "title": "Max Items",
          "type": "integer"
        },
        "max_chars": {
          "minimum": 0,
          "title": "Max Chars",
          "type": "integer"
        },
        "used_items": {
          "minimum": 0,
          "title": "Used Items",
          "type": "integer"
        },
        "used_chars": {
          "minimum": 0,
          "title": "Used Chars",
          "type": "integer"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "excluded_by_budget": {
          "minimum": 0,
          "title": "Excluded By Budget",
          "type": "integer"
        }
      },
      "required": [
        "max_items",
        "max_chars",
        "used_items",
        "used_chars",
        "candidate_count",
        "excluded_by_budget"
      ],
      "title": "MemoryContextBudget",
      "type": "object"
    },
    "MemoryContextDecision": {
      "additionalProperties": false,
      "properties": {
        "memory_type": {
          "enum": [
            "athlete_preference",
            "weekly_training_memory"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "status": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "selected_role_relevant",
            "excluded_role_not_allowed",
            "excluded_wrong_goal",
            "excluded_future",
            "excluded_expired",
            "excluded_superseded",
            "excluded_archived",
            "excluded_invalidated",
            "excluded_outside_target_window",
            "excluded_item_budget",
            "excluded_character_budget"
          ],
          "title": "Reason",
          "type": "string"
        },
        "selected_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Order"
        },
        "estimated_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Chars",
          "type": "integer"
        }
      },
      "required": [
        "memory_type",
        "memory_id",
        "status",
        "selected",
        "reason"
      ],
      "title": "MemoryContextDecision",
      "type": "object"
    },
    "PlanSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scheduled_for": {
          "format": "date",
          "title": "Scheduled For",
          "type": "string"
        },
        "session_type": {
          "enum": [
            "easy",
            "long_run",
            "tempo",
            "interval",
            "recovery",
            "rest",
            "test"
          ],
          "title": "Session Type",
          "type": "string"
        },
        "distance_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Meters"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "intensity": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "purpose": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "status": {
          "default": "planned",
          "enum": [
            "planned",
            "completed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "linked_activity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linked Activity Id"
        }
      },
      "required": [
        "scheduled_for",
        "session_type",
        "purpose"
      ],
      "title": "PlanSession",
      "type": "object"
    },
    "PlanWeeklyMemoryContextItem": {
      "additionalProperties": false,
      "description": "Plan 可读取的周训练基线；类型层面不存在恢复敏感字段。",
      "properties": {
        "memory_type": {
          "const": "weekly_training_memory",
          "default": "weekly_training_memory",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "week_start": {
          "format": "date",
          "title": "Week Start",
          "type": "string"
        },
        "week_end": {
          "format": "date",
          "title": "Week End",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "completion_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Rate"
        },
        "actual_duration_seconds": {
          "minimum": 0,
          "title": "Actual Duration Seconds",
          "type": "integer"
        },
        "actual_distance_meters": {
          "minimum": 0,
          "title": "Actual Distance Meters",
          "type": "number"
        },
        "check_in_days": {
          "minimum": 0,
          "title": "Check In Days",
          "type": "integer"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Data",
          "type": "array"
        },
        "role": {
          "const": "plan",
          "default": "plan",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "week_start",
        "week_end",
        "version",
        "input_hash",
        "actual_duration_seconds",
        "actual_distance_meters",
        "check_in_days"
      ],
      "title": "PlanWeeklyMemoryContextItem",
      "type": "object"
    },
    "PreferenceMemoryContextItem": {
      "additionalProperties": false,
      "properties": {
        "memory_type": {
          "const": "athlete_preference",
          "default": "athlete_preference",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "key": {
          "const": "preferred_long_run_weekday",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Value",
          "type": "string"
        },
        "schema_version": {
          "const": "athlete-preference/1.0",
          "default": "athlete-preference/1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "key",
        "value"
      ],
      "title": "PreferenceMemoryContextItem",
      "type": "object"
    },
    "RecoveryWeeklyMemoryContextItem": {
      "additionalProperties": false,
      "description": "Recovery 可读取的周负荷与恢复聚合。",
      "properties": {
        "memory_type": {
          "const": "weekly_training_memory",
          "default": "weekly_training_memory",
          "title": "Memory Type",
          "type": "string"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "week_start": {
          "format": "date",
          "title": "Week Start",
          "type": "string"
        },
        "week_end": {
          "format": "date",
          "title": "Week End",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "completion_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Rate"
        },
        "actual_duration_seconds": {
          "minimum": 0,
          "title": "Actual Duration Seconds",
          "type": "integer"
        },
        "actual_distance_meters": {
          "minimum": 0,
          "title": "Actual Distance Meters",
          "type": "number"
        },
        "check_in_days": {
          "minimum": 0,
          "title": "Check In Days",
          "type": "integer"
        },
        "missing_data": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Data",
          "type": "array"
        },
        "role": {
          "const": "recovery",
          "default": "recovery",
          "title": "Role",
          "type": "string"
        },
        "average_fatigue": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Fatigue"
        },
        "average_soreness": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Soreness"
        },
        "average_readiness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Readiness"
        },
        "max_pain_severity": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pain Severity"
        },
        "acute_symptom_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acute Symptom Days"
        }
      },
      "required": [
        "memory_id",
        "week_start",
        "week_end",
        "version",
        "input_hash",
        "actual_duration_seconds",
        "actual_distance_meters",
        "check_in_days"
      ],
      "title": "RecoveryWeeklyMemoryContextItem",
      "type": "object"
    },
    "SessionExecutionComparison": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "scheduled_for": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Scheduled For",
          "type": "string"
        },
        "session_type": {
          "minLength": 1,
          "title": "Session Type",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "complete",
            "partial",
            "skipped",
            "unmatched",
            "upcoming",
            "rest"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "match_state": {
          "enum": [
            "confirmed",
            "suggested",
            "ambiguous",
            "none",
            "broken_link"
          ],
          "title": "Match State",
          "type": "string"
        },
        "suggested_activity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Activity Id"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ExecutionCandidate"
          },
          "maxItems": 10,
          "title": "Candidates",
          "type": "array"
        },
        "completion_ratio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Ratio"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "requires_user_confirmation": {
          "title": "Requires User Confirmation",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ExecutionEvidence"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "scheduled_for",
        "session_type",
        "outcome",
        "match_state",
        "confidence",
        "requires_user_confirmation",
        "evidence"
      ],
      "title": "SessionExecutionComparison",
      "type": "object"
    },
    "TrainingExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ruleset_version": {
          "const": "training-execution-rules/1.0",
          "default": "training-execution-rules/1.0",
          "title": "Ruleset Version",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "goal_id": {
          "minLength": 1,
          "title": "Goal Id",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "plan_revision": {
          "minimum": 1,
          "title": "Plan Revision",
          "type": "integer"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionExecutionComparison"
          },
          "maxItems": 14,
          "title": "Sessions",
          "type": "array"
        },
        "unassigned_activity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unassigned Activity Ids",
          "type": "array"
        },
        "memory_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentMemoryContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "input_hash",
        "goal_id",
        "plan_id",
        "plan_revision",
        "as_of",
        "summary",
        "sessions"
      ],
      "title": "训练执行对照输出",
      "type": "object"
    },
    "TrainingGoal": {
      "additionalProperties": false,
      "description": "用户明确声明的训练目标，而不是 Agent 猜测出来的目标。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "5k",
            "10k",
            "half_marathon",
            "marathon",
            "general_fitness"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        },
        "target_time_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Time Seconds"
        },
        "available_weekdays": {
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Available Weekdays",
          "type": "array"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "achieved",
            "abandoned"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "event_type",
        "target_date",
