{
  "$defs": {
    "SourceProvider": {
      "enum": [
        "coros",
        "fit",
        "keep",
        "manual",
        "fixture"
      ],
      "title": "SourceProvider",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "goal_id": {
      "description": "RunCrew 内部训练目标 ID。",
      "minLength": 1,
      "title": "Goal Id",
      "type": "string"
    },
    "week_start": {
      "description": "待规划训练周的周一日期。",
      "format": "date",
      "title": "Week Start",
      "type": "string"
    },
    "as_of": {
      "description": "生成草案时的知识截止时间，必须包含时区。",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "lookback_days": {
      "default": 28,
      "maximum": 56,
      "minimum": 14,
      "title": "Lookback Days",
      "type": "integer"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceProvider"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可选活动来源过滤；多来源可能重复时应显式指定。"
    }
  },
  "required": [
    "goal_id",
    "week_start",
    "as_of"
  ],
  "title": "跑步周计划草案输入",
  "type": "object"
}
