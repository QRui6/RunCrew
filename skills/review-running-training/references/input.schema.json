{
  "$defs": {
    "PlannedSession": {
      "additionalProperties": false,
      "properties": {
        "distance_meters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "计划完成的距离，单位为米。",
          "title": "Distance Meters"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "计划训练的持续时间，单位为秒。",
          "title": "Duration Seconds"
        }
      },
      "title": "计划训练目标",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target_activity_id": {
      "description": "需要复盘的 RunCrew 内部活动 ID。",
      "minLength": 1,
      "title": "Target Activity Id",
      "type": "string"
    },
    "lookback_days": {
      "default": 28,
      "description": "构建历史上下文时向前回看的天数。",
      "maximum": 90,
      "minimum": 14,
      "title": "Lookback Days",
      "type": "integer"
    },
    "planned_session": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlannedSession"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "用户明确提供的本次训练计划；没有计划时必须留空。"
    }
  },
  "required": [
    "target_activity_id"
  ],
  "title": "训练复盘输入",
  "type": "object"
}
