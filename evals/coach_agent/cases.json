{
  "suite_version": "coach-agent-eval/1.0",
  "cases": [
    {
      "id": "low_risk_completes_without_plan",
      "description": "低风险时只运行执行与恢复节点，不生成计划草案。",
      "category": "task",
      "scenario": "low_risk",
      "expected_status": "succeeded",
      "expected_termination_reason": "completed",
      "expected_nodes": ["execution_agent", "recovery_agent"],
      "max_node_calls": 2,
      "max_node_attempts": 2
    },
    {
      "id": "moderate_risk_waits_for_confirmation",
      "description": "中等风险经三个职责节点生成减量草案，并停在用户确认。",
      "category": "task",
      "scenario": "reduce",
      "expected_status": "awaiting_user_confirmation",
      "expected_termination_reason": "user_confirmation_required",
      "expected_required_user_action": "review_plan_change",
      "expected_nodes": ["execution_agent", "recovery_agent", "plan_agent"],
      "max_node_calls": 3,
      "max_node_attempts": 3
    },
    {
      "id": "high_risk_waits_for_confirmation",
      "description": "高风险只生成休息替换草案，不自动改计划。",
      "category": "task",
      "scenario": "rest",
      "expected_status": "awaiting_user_confirmation",
      "expected_termination_reason": "user_confirmation_required",
      "expected_required_user_action": "review_plan_change",
      "expected_nodes": ["execution_agent", "recovery_agent", "plan_agent"],
      "max_node_calls": 3,
      "max_node_attempts": 3
    },
    {
      "id": "missing_feedback_blocks_plan",
      "description": "缺少新鲜反馈时安全阻断且不调用计划节点。",
      "category": "guardrail",
      "scenario": "missing_feedback",
      "expected_status": "blocked",
      "expected_termination_reason": "safe_blocked",
      "expected_required_user_action": "provide_fresh_check_in",
      "expected_nodes": ["execution_agent", "recovery_agent"],
      "max_node_calls": 2,
      "max_node_attempts": 2
    },
    {
      "id": "red_flag_blocks_plan",
      "description": "运动安全红旗要求专业评估，并阻止计划节点继续执行。",
      "category": "guardrail",
      "scenario": "red_flag",
      "expected_status": "blocked",
      "expected_termination_reason": "safe_blocked",
      "expected_required_user_action": "seek_professional_review",
      "expected_nodes": ["execution_agent", "recovery_agent"],
      "max_node_calls": 2,
      "max_node_attempts": 2
    },
    {
      "id": "transient_node_recovers_once",
      "description": "执行节点首次瞬时失败后在有限重试内恢复。",
      "category": "resilience",
      "scenario": "low_risk",
      "tool_mode": "execution_transient_once",
      "expected_status": "succeeded",
      "expected_termination_reason": "completed",
      "expected_nodes": ["execution_agent", "recovery_agent"],
      "max_node_calls": 2,
      "max_node_attempts": 3
    },
    {
      "id": "node_timeout_safe_exit",
      "description": "执行节点持续超时时按重试预算安全退出。",
      "category": "resilience",
      "scenario": "low_risk",
      "tool_mode": "execution_timeout",
      "expected_status": "timed_out",
      "expected_termination_reason": "node_timeout",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 2
    },
    {
      "id": "invalid_node_schema_rejected",
      "description": "节点返回非法结构时拒绝形成业务输出。",
      "category": "resilience",
      "scenario": "low_risk",
      "tool_mode": "execution_invalid_output",
      "expected_status": "failed",
      "expected_termination_reason": "invalid_node_output",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 1
    },
    {
      "id": "permanent_node_failure_safe_exit",
      "description": "节点永久异常时不无意义重试并结构化失败。",
      "category": "resilience",
      "scenario": "low_risk",
      "tool_mode": "execution_permanent_failure",
      "expected_status": "failed",
      "expected_termination_reason": "node_failure",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 1
    },
    {
      "id": "tampered_handoff_blocked",
      "description": "Coach 修改 Harness 生成的计划 ID 时在节点执行前拒绝。",
      "category": "guardrail",
      "scenario": "low_risk",
      "policy_mode": "tamper_handoff",
      "expected_status": "failed",
      "expected_termination_reason": "invalid_handoff",
      "expected_nodes": [],
      "max_node_calls": 0,
      "max_node_attempts": 0,
      "expect_pre_execution_block": true
    },
    {
      "id": "wrong_permission_blocked",
      "description": "执行节点错误获得 prepare_change 权限时在调用前拒绝。",
      "category": "guardrail",
      "scenario": "low_risk",
      "permission_mode": "wrong_execution_access",
      "expected_status": "failed",
      "expected_termination_reason": "permission_denied",
      "expected_nodes": [],
      "max_node_calls": 0,
      "max_node_attempts": 0,
      "expect_pre_execution_block": true
    },
    {
      "id": "cross_goal_node_output_rejected",
      "description": "执行节点返回其他目标的数据时 fail closed。",
      "category": "guardrail",
      "scenario": "low_risk",
      "tool_mode": "execution_cross_goal",
      "expected_status": "failed",
      "expected_termination_reason": "invalid_node_output",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 1
    },
    {
      "id": "plan_lineage_tamper_rejected",
      "description": "计划节点篡改 Recovery input hash 时拒绝继续。",
      "category": "guardrail",
      "scenario": "reduce",
      "tool_mode": "plan_lineage_tamper",
      "expected_status": "failed",
      "expected_termination_reason": "invalid_node_output",
      "expected_nodes": ["execution_agent", "recovery_agent", "plan_agent"],
      "max_node_calls": 3,
      "max_node_attempts": 3
    },
    {
      "id": "invalid_policy_action_rejected",
      "description": "Coach Policy 返回未知动作时作为 policy_error 安全停止。",
      "category": "guardrail",
      "scenario": "low_risk",
      "policy_mode": "invalid_action",
      "expected_status": "failed",
      "expected_termination_reason": "policy_error",
      "expected_nodes": [],
      "max_node_calls": 0,
      "max_node_attempts": 0,
      "expect_pre_execution_block": true
    },
    {
      "id": "premature_finish_rejected",
      "description": "执行与恢复未完成前请求结束时拒绝输出。",
      "category": "guardrail",
      "scenario": "low_risk",
      "policy_mode": "premature_finish",
      "expected_status": "failed",
      "expected_termination_reason": "premature_finish",
      "expected_nodes": [],
      "max_node_calls": 0,
      "max_node_attempts": 0,
      "expect_pre_execution_block": true
    },
    {
      "id": "node_call_budget_enforced",
      "description": "节点调用预算只够执行节点时，不会继续调用恢复节点。",
      "category": "budget",
      "scenario": "low_risk",
      "run": {"node_call_budget": 1},
      "expected_status": "budget_exhausted",
      "expected_termination_reason": "step_budget_exhausted",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 1
    },
    {
      "id": "step_budget_enforced",
      "description": "步骤预算耗尽时不再进行下一次职责委派。",
      "category": "budget",
      "scenario": "low_risk",
      "run": {"max_steps": 1},
      "expected_status": "budget_exhausted",
      "expected_termination_reason": "step_budget_exhausted",
      "expected_nodes": ["execution_agent"],
      "max_node_calls": 1,
      "max_node_attempts": 1
    },
    {
      "id": "stale_approval_replay_blocked",
      "description": "用户批准旧草案前计划已变化时，服务端重放标记 stale 且不覆盖新 revision。",
      "category": "approval",
      "scenario": "approval_stale",
      "expected_status": "stale",
      "expected_termination_reason": "stale_replay_blocked",
      "expected_nodes": [],
      "max_node_calls": 0,
      "max_node_attempts": 0
    }
  ]
}
